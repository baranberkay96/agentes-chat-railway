{
  "name": "AI Team Chat for Humans and Agents (Self-Hosted)",
  "description": "Self-hosted team chat where AI agents work in channels, with a computer",
  "category": "AI/ML",
  "tags": ["team-chat", "slack-alternative", "ai-agents", "claude", "codex", "mcp", "self-hosted"],
  "image": "https://cdn.jsdelivr.net/npm/lucide-static@0.460.0/icons/messages-square.svg",
  "upstream": {
    "agentes": "agentes-chat/agentes-chat (AGPL-3.0) v0.1.10 (2026-11-20); image ghcr.io/agentes-chat/agentes:0.1.10, backup image ghcr.io/agentes-chat/backup:0.1.10",
    "checked": "2026-11-20"
  },
  "services": {
    "agentes": {
      "icon": "https://cdn.jsdelivr.net/npm/lucide-static@0.460.0/icons/messages-square.svg",
      "source": {"repo": "baranberkay96/agentes-chat-railway", "rootDirectory": "/services/app"},
      "startCommand": null,
      "healthcheckPath": "/api/health",
      "healthcheckTimeout": 600,
      "restartPolicyType": "ALWAYS",
      "publicDomain": true,
      "targetPort": 3000,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "PORT": {"defaultValue": "3000", "description": "Port of the web app, API and WebSockets (healthcheck and public domain target).", "required": true},
        "HOST": {"defaultValue": "::", "description": "Listen on IPv4 and IPv6 so the computer service reaches the app over the private network.", "required": true},
        "PUBLIC_URL": {"defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}", "description": "Exact address people open (sign-in cookies, allowed origin, links). Change it when you add a custom domain.", "required": true},
        "DATABASE_URL": {"defaultValue": "${{Postgres.DATABASE_URL}}", "description": "Postgres (with pgvector) in this project.", "required": true},
        "AGENTES_SECRET": {"defaultValue": "${{secret(64)}}", "description": "Master secret: signs sessions and encrypts stored provider keys. Generated; back it up and never change it.", "required": true},
        "AGENTES_OWNER_CLAIM_TOKEN": {"defaultValue": "${{secret(40)}}", "description": "Only {PUBLIC_URL}/owner#claim={this token} can create the first (owner) account. Generated; 20-200 chars of A-Z a-z 0-9 _ -.", "required": true},
        "HOST_COMPUTER_TOKEN": {"defaultValue": "${{secret(48)}}", "description": "Shared secret that connects the computer service as the agents' computer. Generated.", "required": true},
        "S3_ENDPOINT": {"defaultValue": "${{Files.ENDPOINT}}", "description": "Railway Bucket for uploaded files, attachments and artifacts.", "required": true},
        "S3_REGION": {"defaultValue": "${{Files.REGION}}", "description": "Files bucket region.", "required": true},
        "S3_BUCKET": {"defaultValue": "${{Files.BUCKET}}", "description": "Files bucket name.", "required": true},
        "S3_ACCESS_KEY_ID": {"defaultValue": "${{Files.ACCESS_KEY_ID}}", "description": "Files bucket access key.", "required": true},
        "S3_SECRET_ACCESS_KEY": {"defaultValue": "${{Files.SECRET_ACCESS_KEY}}", "description": "Files bucket secret key.", "required": true},
        "S3_PATH_STYLE": {"defaultValue": "false", "description": "Railway Buckets use virtual-hosted URLs.", "required": true},
        "TELEMETRY": {"defaultValue": "off", "description": "Daily anonymous usage counts to agentes.chat (on/off). Off by default in this template.", "required": false},
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {"defaultValue": "40", "description": "Lets agent runs in progress finish (20 s) when the service restarts.", "required": false}
      }
    },
    "computer": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/debian-linux.svg",
      "source": {"repo": "baranberkay96/agentes-chat-railway", "rootDirectory": "/services/computer"},
      "startCommand": null,
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ALWAYS",
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": {"mountPath": "/home/agent"},
      "variables": {
        "AGENTES_SERVER_URL": {"defaultValue": "http://${{agentes.RAILWAY_PRIVATE_DOMAIN}}:${{agentes.PORT}}", "description": "The agentes.chat service on the private network (runner download and connection).", "required": true},
        "HOST_COMPUTER_TOKEN": {"defaultValue": "${{agentes.HOST_COMPUTER_TOKEN}}", "description": "Must equal the agentes service's token (referenced; edit it there).", "required": true},
        "AGENTES_COMPUTER_NAME": {"defaultValue": "Railway computer", "description": "Name the computer shows in Settings > Devices (letters, digits, space . _ -).", "required": false}
      }
    },
    "backup": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/postgresql.svg",
      "source": {"image": "ghcr.io/agentes-chat/backup:0.1.10@sha256:e659b8a2b78fe464d90a9a27ffd4a3e6d72a637e3511b518f3079669a3eb821a"},
      "startCommand": null,
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ALWAYS",
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "DATABASE_URL": {"defaultValue": "${{Postgres.DATABASE_URL}}", "description": "Database to dump.", "required": true},
        "S3_PROVIDER": {"defaultValue": "Other", "description": "rclone provider name for the bucket (Other for Railway Buckets).", "required": true},
        "S3_ENDPOINT": {"defaultValue": "${{Backups.ENDPOINT}}", "description": "Railway Bucket for the database dumps.", "required": true},
        "S3_REGION": {"defaultValue": "${{Backups.REGION}}", "description": "Backups bucket region.", "required": true},
        "S3_BACKUP_BUCKET": {"defaultValue": "${{Backups.BUCKET}}", "description": "Backups bucket name.", "required": true},
        "S3_ACCESS_KEY_ID": {"defaultValue": "${{Backups.ACCESS_KEY_ID}}", "description": "Backups bucket access key.", "required": true},
        "S3_SECRET_ACCESS_KEY": {"defaultValue": "${{Backups.SECRET_ACCESS_KEY}}", "description": "Backups bucket secret key.", "required": true},
        "RCLONE_S3_FORCE_PATH_STYLE": {"defaultValue": "false", "description": "Railway Buckets use virtual-hosted URLs.", "required": true},
        "BACKUP_INTERVAL_HOURS": {"defaultValue": "24", "description": "Hours between dumps, counted from 03:00 UTC (24 = daily, 6 = four a day).", "required": false},
        "BACKUP_RETENTION_DAYS": {"defaultValue": "14", "description": "Dumps older than this many days are deleted.", "required": false}
      }
    },
    "Postgres": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/postgresql.svg",
      "source": {"image": "ghcr.io/railwayapp-templates/postgres-ssl:18.6@sha256:4fc833b43d2aaf6ecc9b18615f5533602b723a32d0e2efe2dae8ca0f7217c863"},
      "restartPolicyType": "ALWAYS",
      "publicDomain": false,
      "volume": {"mountPath": "/var/lib/postgresql/data"},
      "variables": {
        "PGDATA": {"defaultValue": "/var/lib/postgresql/data/pgdata", "description": "Location where the database will be initialized", "required": true},
        "PGHOST": {"defaultValue": "${{RAILWAY_PRIVATE_DOMAIN}}", "description": "Railway Private Domain Name.", "required": true},
        "PGPORT": {"defaultValue": "5432", "description": "Port to connect to Postgres.", "required": true},
        "PGUSER": {"defaultValue": "${{ POSTGRES_USER }}", "description": "Required variable for Data panel", "required": true},
        "PGDATABASE": {"defaultValue": "${{POSTGRES_DB}}", "description": "Required variable for the data panel.", "required": true},
        "PGPASSWORD": {"defaultValue": "${{POSTGRES_PASSWORD}}", "description": "Required variable for Data panel", "required": true},
        "POSTGRES_DB": {"defaultValue": "railway", "description": "Default database created when image is started.", "required": true},
        "DATABASE_URL": {"defaultValue": "postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}", "description": "URL to connect to Postgres (the image includes pgvector, which agentes.chat's first migration enables).", "required": true},
        "POSTGRES_USER": {"defaultValue": "postgres", "description": "User to connect to Postgres DB", "required": true},
        "SSL_CERT_DAYS": {"defaultValue": "820", "description": "SSL certificate expiry in days.", "required": false},
        "POSTGRES_PASSWORD": {"defaultValue": "${{ secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\") }}", "description": "Password to connect to DB", "required": true},
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {"defaultValue": "60", "description": "Allow Postgres to cleanly shut down", "required": true}
      }
    }
  },
  "buckets": ["Files", "Backups"]
}
